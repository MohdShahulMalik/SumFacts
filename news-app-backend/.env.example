# Copy to .env and fill in real values. Copying a file does not need access
# to any existing .env: this example is the canonical list of variable names.

# Server Configuration
PORT=5000

# SurrealDB Credentials (use wss://... for a hosted instance)
SURREAL_URL=ws://localhost:8000/rpc
SURREAL_USER=your-surreal-user
SURREAL_PASS=your-surreal-pass
SURREAL_NS=your-namespace
SURREAL_DB=your-database

# API Keys
GNEWS_API_KEY=your-gnews-api-key
GOOGLE_API_KEY=your-google-gemini-api-key
